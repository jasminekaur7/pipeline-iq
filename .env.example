# Pipeline IQ Environment Configuration

# Database (Default uses local SQLite; supports PostgreSQL connection string)
DATABASE_URL=sqlite:///./pipeline_iq.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/pipeline_iq

# LLM Reasoning Engine (Optional: system includes deterministic grounded fallback reasoner)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Configuration (Railway automatically sets PORT; HOST defaults to 0.0.0.0)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Frontend (Vite) - Leave empty for single-origin unified deployment (relative /api requests)
VITE_API_URL=
